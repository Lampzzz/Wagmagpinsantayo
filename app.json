{
  "expo": {
    "name": "Pinsan AI",
    "slug": "wagmagpinsantayo",
    "scheme": "wagmagpinsantayo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "17.0"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.SCHEDULE_EXACT_ALARM"],
      "package": "com.anonymous.wagmagpinsantayo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Pinsan AI uses your microphone to turn what you say into notes, tasks and reminders. Your voice is processed on your phone and never uploaded.",
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": ["android.permission.RECORD_AUDIO"],
          "disableFFmpeg": true
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
